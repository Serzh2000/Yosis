{
  "name": "yosis-fpga-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx server/index.ts",
    "build": "node scripts/build.mjs",
    "build:helper": "node scripts/build-programming-helper.mjs",
    "hardware:helper": "tsx server/programming-helper.ts",
    "start": "node scripts/start.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:simulation": "node scripts/smoke-simulation.mjs",
    "smoke:learning": "tsx scripts/smoke-learning.ts",
    "smoke:physical": "tsx scripts/smoke-physical.ts",
    "smoke:templates": "tsx scripts/smoke-templates.ts",
    "smoke:examples": "tsx scripts/smoke-examples.ts",
    "smoke:example-behavior": "tsx scripts/smoke-example-behavior.ts",
    "smoke:new-example-behavior": "tsx scripts/smoke-new-example-behavior.ts",
    "smoke:wizard": "tsx scripts/smoke-project-wizard.ts",
    "audit:rtl": "tsx scripts/audit-rtl-examples.ts",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "check": "node scripts/check.mjs",
    "setup:iverilog": "node scripts/setup-iverilog.mjs",
    "setup:gowin": "node scripts/setup-gowin.mjs",
    "build:server": "node scripts/build-server.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lint": "eslint src server shared tests scripts/*.mjs",
    "format": "prettier --write src server shared tests scripts/*.mjs *.json *.ts *.mjs e2e .github",
    "format:check": "prettier --check src server shared tests scripts/*.mjs *.json *.ts *.mjs e2e .github",
    "test:e2e": "playwright test",
    "test:firmware": "node scripts/test-firmware.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@yowasp/yosys": "0.70.62-dev.1236",
    "elkjs": "^0.11.0",
    "express": "^5.1.0",
    "lucide-react": "^1.51.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  }
}
