// Tang Nano 20K, GW2AR-LV18QN88C8/I7.
// FPGA package pin numbers, not connector positions.
// Source: https://github.com/YosysHQ/apicula/blob/master/examples/tangnano20k.cst
// User buttons pull the input down when pressed.
IO_LOC "button_a_n" 87;
IO_PORT "button_a_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "button_b_n" 88;
IO_PORT "button_b_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard LEDs are active low. No external wires are needed.
IO_LOC "led_n[0]" 15;
IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led_n[1]" 16;
IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led_n[2]" 17;
IO_PORT "led_n[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led_n[3]" 18;
IO_PORT "led_n[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led_n[4]" 19;
IO_PORT "led_n[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "led_n[5]" 20;
IO_PORT "led_n[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
