# Set YOSIS_DOMAIN to the hostname in YOSIS_PUBLIC_ORIGIN.
{$YOSIS_DOMAIN} {
  request_body {
    max_size 17MB
  }
  reverse_proxy 127.0.0.1:3001 {
    # Yosis с YOSIS_TRUSTED_PROXY_HOPS=1 берёт адрес клиента отсюда для лимита попыток входа.
    # Заголовок перезаписывается адресом соединения: подделанный клиентом X-Forwarded-For не проходит.
    header_up X-Forwarded-For {remote_host}
  }
}
