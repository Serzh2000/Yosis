// =====================================================================
// Файл ограничений (Physical Constraints) для проекта 06_pwm_breath
// Плата: Sipeed Tang Nano 20K, ПЛИС GW2AR-LV18QN88C8/I7
//
// Что делает этот файл: связывает имена портов модуля pwm_breath
// с физическими ножками (выводами) микросхемы и задаёт их электрические
// параметры. В файле перечислены ровно те порты, что есть в модуле.
//
// Синтаксис:
//   IO_LOC  "имя_порта" номер_вывода;          -- к какой ножке подключить
//   IO_PORT "имя_порта" параметр=значение ...; -- как её настроить
// Каждая строка заканчивается точкой с запятой, комментарии начинаются с //.
// Для шины каждый бит описывается отдельно: "led[0]", "led[1]", ...
// =====================================================================

// ==== Тактовый сигнал ====
// Кварцевый генератор 27 МГц на плате подключён к выводу 4.
IO_LOC  "clk" 4;
// LVCMOS33 -- обычная логика с питанием 3,3 В.
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ==== Светодиоды ====
// Шесть светодиодов на выводах 15..20. Они подключены катодом к ножке,
// поэтому горят, когда на выходе 0 (активный низкий уровень).
IO_LOC  "led[0]" 15;
IO_LOC  "led[1]" 16;
IO_LOC  "led[2]" 17;
IO_LOC  "led[3]" 18;
IO_LOC  "led[4]" 19;
IO_LOC  "led[5]" 20;
// DRIVE=8 -- выход может отдать ток до 8 мА, этого хватает светодиоду.
// PULL_MODE=UP -- пока ПЛИС не загружена, выводы подтянуты к 3,3 В и
// светодиоды не горят.
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
