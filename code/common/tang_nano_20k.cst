// =====================================================================
// Файл ограничений (Constraints) для Sipeed Tang Nano 20K
// ПЛИС: GW2AR-LV18QN88C8/I7 (семейство GW2AR-18C)
// Сводная распиновка: все ножки, используемые в примерах учебника.
// Это справочник. В каждом проекте лежит свой .cst ровно с нужными портами.
// Скопируйте в свой проект только те строки, чьи порты есть в модуле!
// =====================================================================

// Тактовый генератор 27 МГц
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Кнопки S1 и S2 (нажата -> 1)
IO_LOC  "btn[0]" 88;
IO_PORT "btn[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "btn[1]" 87;
IO_PORT "btn[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// Шесть светодиодов (активный уровень НИЗКИЙ: 0 -> горит)
IO_LOC  "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
